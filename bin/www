#!/usr/bin/env node

/**
 * Module dependencies.
 */

require('dotenv').config();

var app = require('../app');
var debug = require('debug')('trks:server');
var http = require('http');
const db = require('../config/db');
const { seedIfEmpty } = require('../config/seed');

/**
 * Get port from environment and store in Express.
 * 3001 matches the Flutter app's NetworkService baseUrl.
 */

var port = normalizePort(process.env.PORT || '3001');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Connect to MongoDB, seed if empty, then listen.
 */

db.connect()
    .then(seedIfEmpty)
    .then(function () {
        server.listen(port);
        server.on('error', onError);
        server.on('listening', onListening);
    })
    .catch(function (err) {
        console.error('Failed to start:', err);
        process.exit(1);
    });

/**
 * Graceful shutdown - important when the local MongoDB is in use, so its
 * child process releases the data-directory lock.
 */

['SIGINT', 'SIGTERM'].forEach(function (signal) {
    process.on(signal, function () {
        console.log(signal + ' received, shutting down...');
        server.close(function () {
            db.disconnect()
                .then(function () { process.exit(0); })
                .catch(function () { process.exit(1); });
        });
        // force-exit if something hangs
        setTimeout(function () { process.exit(1); }, 10000).unref();
    });
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('tRKS API listening on ' + bind);
}
