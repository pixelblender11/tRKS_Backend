# Server
PORT=3001

# Database
# Leave DATABASE_URL empty for local development - a local PostgreSQL is
# started automatically (data persisted under ./data/pg).
# For production point this at your OVH managed PostgreSQL, e.g.:
#   DATABASE_URL=postgres://avnadmin:pass@postgresql-xxxx.database.cloud.ovh.net:20184/defaultdb
#   DB_SSL=true
DATABASE_URL=
DB_SSL=false
# Set to false only if your provider uses a self-signed CA you haven't installed
DB_SSL_REJECT_UNAUTHORIZED=true
# Port for the auto-started local dev cluster
LOCAL_PG_PORT=5433

# Auth - generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_TTL=24h
